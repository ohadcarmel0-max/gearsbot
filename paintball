#!/usr/bin/env python3

# Import the necessary libraries
import time
import math
from ev3dev2.motor import *
from ev3dev2.sound import Sound
from ev3dev2.button import Button
from ev3dev2.sensor import *
from ev3dev2.sensor.lego import *
from ev3dev2.sensor.virtual import *

# Create the sensors and motors objects
motorA = LargeMotor(OUTPUT_A)
motorB = LargeMotor(OUTPUT_B)
left_motor = motorA
right_motor = motorB
tank_drive = MoveTank(OUTPUT_A, OUTPUT_B)
steering_drive = MoveSteering(OUTPUT_A, OUTPUT_B)

spkr = Sound()
btn = Button()
radio = Radio()
obtr = ObjectTracker()

color_sensor_in1 = ColorSensor(INPUT_1)
color_sensor_in2 = ColorSensor(INPUT_2)
laser_sensor_in3 = LaserRangeSensor(INPUT_3)
gyro_sensor_in4 = GyroSensor(INPUT_4)
gps_sensor_in5 = GPSSensor(INPUT_5)

motorC = LargeMotor(OUTPUT_C) # Magnet
motorD = LargeMotor(OUTPUT_D) # Arm
motorE = LargeMotor(OUTPUT_E) # Paintball Launcher

# Here is where your code starts

angle = None
force = None

# Describe this function...
def my_1shot(angle, force):
    motorD.on_for_degrees(5, angle)
    motorE.on_for_degrees((-100), force)
    motorE.on_for_rotations(100, 1)


if laser_sensor_in3.distance_centimeters > 360:
    my_1shot((laser_sensor_in3.distance_centimeters / 1000) * 85, 1000)
elif laser_sensor_in3.distance_centimeters > 130 and laser_sensor_in3.distance_centimeters < 150:
    my_1shot((laser_sensor_in3.distance_centimeters / 1000) * 73, 1000)
else:
    my_1shot((laser_sensor_in3.distance_centimeters / 1000) * 78, 1000)
